# weFit systemd **用户级**单元 —— 个人机/局域网开机自启（全程无需 sudo）
#
# 与 deploy/wefit.service（系统级、公网反代版）的分工：
#   - 本文件：服务跑在 qtfan 的用户实例里，HOST 不设 = 0.0.0.0 监听所有网卡，
#     同 Wi-Fi 手机可直连 8123；注册保持开放——**只用于可信局域网**。
#   - 公网部署别用本文件，走系统级 wefit.service + Caddy 反代（回环监听 + 关注册）。
#
# 用法（在本机以 qtfan 身份）：
#   mkdir -p ~/.config/systemd/user
#   cp deploy/wefit.user.service ~/.config/systemd/user/wefit.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now wefit
#   loginctl enable-linger qtfan     # 开机不等登录就拉起（legion 已开）
# 查日志：journalctl --user -u wefit -f    停止：systemctl --user stop wefit
#
# ⚠ 路径按 legion.unix.release 实况钉死：
#   - ExecStart 的 node 是 nvm 绝对路径，nvm 升级后要跟着改（或 ln -s 稳定链接）；
#   - 数据盘 /media/qtfan/Data 在 fstab（nofail），用户单元不能对系统挂载单元排序，
#     用 ExecStartPre 循环等待目录就绪，最多 60s。

[Unit]
Description=weFit 健康管理同步服务器（用户单元 · 局域网）
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -f /media/qtfan/Data/DEVELOPMENTS/weFit/server/server.js ] && exit 0; sleep 2; done; exit 1'

[Service]
Type=simple
WorkingDirectory=/media/qtfan/Data/DEVELOPMENTS/weFit/server
ExecStart=/home/qtfan/.nvm/versions/node/v26.7.0/bin/node server.js
Environment=PORT=8123
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
